    "compare:grading:3": "tsx src/gradingComparison/main.ts src/gradingComparison/input/graded-main.json src/gradingComparison/input/graded-1.json src/gradingComparison/input/graded-2.json src/gradingComparison/input/graded-3.json",
    "compare:individual:2": "tsx src/individualComparison/main.ts src/individualComparison/input/graded-main.json src/individualComparison/input/graded-1.json src/individualComparison/input/graded-2.json",
    "compare:individual:3": "tsx src/individualComparison/main.ts src/individualComparison/input/graded-main.json src/individualComparison/input/graded-1.json src/individualComparison/input/graded-2.json src/individualComparison/input/graded-3.json",
    "generate:regional-coords": "tsx src/fillRegionalAnlysis/generateCoordinates.ts",
    "fill:regional": "tsx src/fillRegionalAnlysis/main.ts",
    "generate:individual-coords": "tsx src/fillindividualAnlysis/generateCoordinates.ts",
    "fill:individual": "tsx src/fillindividualAnlysis/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
