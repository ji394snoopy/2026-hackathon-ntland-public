{
  "name": "cli-util",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript utilities for different purposes.",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "extract:fs": "tsx src/factorStandard/main.ts references/factor-standard.pdf",
    "grade:regional": "tsx src/regionalFactorGrading/main.ts",
    "grade:individual": "tsx src/individualFactorGrading/main.ts",
    "fill:all": "tsx src/districtSurvey/main.ts",
    "fill:standalone": "tsx src/fillDistrictSurvey/main.ts",
    "generate:coordinates": "tsx src/districtSurvey/generateCoordinates.ts",
    "fetch:topo": "tsx src/mapTiles/detailTopo/main.ts",
    "fetch:base": "tsx src/mapTiles/baseTopo/main.ts",
    "fetch:drainage": "tsx src/drainageQuality/main.ts",
    "fetch:wind": "tsx src/windCondition/main.ts",
    "fetch:soil": "tsx src/soilQuality/main.ts",
    "fetch:osm": "tsx src/osmFacilities/main.ts",
    "fetch:air": "tsx src/environmentalPollution/airPollution/main.ts",
    "fetch:water": "tsx src/environmentalPollution/waterPollution/main.ts",
    "fetch:noise": "tsx src/environmentalPollution/noisePollution/main.ts",
    "fetch:soil-contamination": "tsx src/environmentalPollution/soilGroundwaterContamination/main.ts",
    "fetch:waste-dumping": "tsx src/environmentalPollution/wasteDumping/main.ts",
