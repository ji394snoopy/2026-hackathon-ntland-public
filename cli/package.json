  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "latest",
    "@anthropic-ai/sdk": "latest",
    "@pdf-lib/fontkit": "^1.1.1",
    "adm-zip": "^0.6.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pngjs": "^7.0.0",
    "proj4": "^2.22.0",
    "shapefile": "^0.6.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.19.43",
    "@types/pngjs": "^6.0.5",
    "@types/shapefile": "^0.6.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
