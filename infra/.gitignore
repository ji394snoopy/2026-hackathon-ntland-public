*.js
!jest.config.js
*.d.ts
node_modules

# CDK asset staging directory
.cdk.staging
cdk.out

# esbuild-bundled Lambda handlers (build output; produced by npm run build:lambdas)
build/lambda

# local geojson data staged for the asset bucket (large, not for git)
assets/data/*.geojson

# CDK context cache (account/region-specific lookups, machine-local)
cdk.context.json

# local-only deploy notes
local-deploy-steps.txt

# invoke-local output (generated PDFs/PNGs from lambda/<name>/invoke-local.ts)
tmp/

docs/
